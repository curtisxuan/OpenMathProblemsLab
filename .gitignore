# Build artifacts — rebuildable from cache + a pipeline re-run. See ADR-0006.
db/
*.sqlite
*.sqlite3

# Working cache: papers, extractions, assessments. Machine output, overwritten
# every run, ~420MB/month of sources. See ADR-0006.
# NOTE: examples/ is deliberately NOT ignored -- it is a curated, frozen subset
# so a fresh clone can show real output. See examples/README.md.
cache/

# Generated reports
digest/

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# long-run logs
*.log
